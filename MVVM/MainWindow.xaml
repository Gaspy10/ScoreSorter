<Window x:Class="MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:MVVM.CustomUserControls"
        xmlns:local="clr-namespace:MVVM"
        mc:Ignorable="d" Style="{StaticResource DefaultWindow}"
        
        Title="Sorter" Height="600" Width="1000" MinHeight="510" MinWidth="820">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseDown">
            <i:InvokeCommandAction Command="{Binding DragCommand}" 
                           CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <uc:WindowInteract Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,5,0"/>

        <DataGrid 
            Grid.Row="1"
            RowStyle="{StaticResource SelectedRowStyle}"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem}"
            IsReadOnly="True"
            CanUserAddRows="False" 
            CanUserDeleteRows="False" 
            AutoGenerateColumns="False"
            Background="#4d4d4d"
            BorderThickness="2"
            Margin="9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="4*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="4*"/>
                <DataGridTextColumn Header="Points" Binding="{Binding Points}" Width="4*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border BorderBrush="#8e546f" BorderThickness="2" Padding="10" Grid.Column="1" Grid.Row="1" Height="462" Width="246">

            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">

                <uc:DatagridTextbox x:Name="ahoj" NameText="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" 
                                    PointsText="{Binding NewSurname, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>

                <Button x:Name="addBut" Content="Add" Command="{Binding AddCommand,
                    UpdateSourceTrigger=PropertyChanged}" Margin="0, 30, 0, 0" Style="{StaticResource InteractButtons}"/>

                <Button Name="delBut" Content="Delete" Command="{Binding RemoveCommand,
                    UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Style="{StaticResource InteractButtons}"/>

                <Button Name="editBut" Content="Edit" Command="{Binding EditCommand,
                    UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Style="{StaticResource InteractButtons}"/>

                <Button Name="importBut" Content="Import" Command="{Binding ImportCommand,
                    UpdateSourceTrigger=PropertyChanged}" Margin="0,45,0,0" Style="{StaticResource InteractButtons}"/>

                <Button Name="exportBut" Content="Export image" Command="{Binding ExportCommand,
                    UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" Style="{StaticResource InteractButtons}"/>
            </StackPanel>
        </Border>

        <!-- <Label Content="Sorter" FontSize="25" FontStyle="Oblique" Style="{StaticResource MainLabel}"/> -->
    </Grid>

</Window>
