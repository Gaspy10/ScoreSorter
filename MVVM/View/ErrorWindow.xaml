<Window x:Class="MVVM.View.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:uc="clr-namespace:MVVM.CustomUserControls"
        mc:Ignorable="d" Style="{StaticResource DefaultWindow}"
        Title="ErrorWindow" Height="210" Width="450" ResizeMode="NoResize">
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseDown">
            <i:InvokeCommandAction Command="{Binding DragCommand}" 
                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
    
        <uc:WindowInteract Grid.Row="0" HorizontalAlignment="Right" Margin="0, 0, 5, 0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <Image Source="{StaticResource di_Error_xaml}" Width="50" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0"/>

                    <!--<Label Style="{StaticResource InfoLabel}" Foreground="White" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Content="Something went wrong."/>-->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1">
                <Label Style="{StaticResource MainLabel}" Foreground="White" FontSize="20">
                    <Label.Content>
                        <TextBlock Text="Something went wrong: " TextWrapping="Wrap"/>
                    </Label.Content>
                </Label>

                <Label Style="{StaticResource InfoLabel}" Foreground="White" Grid.Column="1" HorizontalAlignment="Left"
                   VerticalAlignment="Center" FontSize="20" Width="Auto">
                    <Label.Content>
                        <TextBlock Text="{Binding ErrorMessage, UpdateSourceTrigger=PropertyChanged}" TextWrapping="WrapWithOverflow" Width="Auto"/>
                    </Label.Content>
                </Label>

                <Label Style="{StaticResource MainLabel}" Foreground="White" VerticalAlignment="Center" 
                       HorizontalAlignment="Left" FontSize="20">
                    <Label.Content>
                        <TextBlock Text="Please make sure the selected image is in correct format." TextWrapping="Wrap" Width="Auto"/>
                    </Label.Content>
                </Label>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
