<Window x:Class="MVVM.View.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:MVVM.CustomUserControls"
        xmlns:local="clr-namespace:MVVM.View"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d" Style="{StaticResource DefaultWindow}"
        Title="LoadingWindow" Height="200" Width="400">
           
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseDown">
            <i:InvokeCommandAction Command="{Binding DragCommand}" 
                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <uc:WindowInteract Grid.Row="0" Margin="0,0,5,0" HorizontalAlignment="Right"/>

        <Label Grid.Row="1" Content="Please wait..." HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource InfoLabel}" FontSize="23"/>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Label Style="{StaticResource MainLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Content="{Binding ProcessStateText, UpdateSourceTrigger=PropertyChanged}" FontSize="30"/>
            <ProgressBar IsIndeterminate="True" Margin="15" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
