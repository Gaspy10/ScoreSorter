<Window x:Class="MVVM.View.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:MVVM.CustomUserControls"
        xmlns:local="clr-namespace:MVVM.View"
        mc:Ignorable="d" Style="{StaticResource DefaultWindow}"
        Title="InfoDialog" Height="800" Width="1000" ResizeMode="NoResize">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseDown">
            <i:InvokeCommandAction Command="{Binding DragCommand}" 
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="1" Content="Please crop your image before importing." Style="{StaticResource MainLabel}"
               HorizontalAlignment="Center" FontSize="30" FontStyle="Italic" FontWeight="Bold" VerticalAlignment="Center"/>

        <uc:WindowInteract HorizontalAlignment="Right" Margin="0,0,5,0"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#8e546f" BorderThickness="2" Padding="10" Height="580" Width="400">

                <StackPanel Orientation="Vertical">
                    <Image Name="ValidOption" Source="../Resources/InvalidOption.JPEG" Margin="0" Height="500" RenderOptions.BitmapScalingMode="Fant"/>
                    <Image Source="{StaticResource di_Cross_xaml}" Width="50" Margin="5"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="#8e546f" BorderThickness="2" Padding="10" Grid.Column="1" Height="580" Width="400">
                
                <StackPanel Orientation="Vertical">
                    <Image Name="InvalidOption" Source="../Resources/ValidOption.JPEG" Margin="0" RenderOptions.BitmapScalingMode="Fant" Height="500"/>
                    <Image Source="{StaticResource di_Tick_xaml}" Width="68" Margin="5"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Style="{StaticResource InteractButtons}" Content="Cancel" 
                        Command="{Binding CancelCommand}" Margin="3" Width="100"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                
                <Button Style="{StaticResource InteractButtons}" Content="Continue" 
                        Command="{Binding ContinueCommand}" Margin="3" Width="100" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
