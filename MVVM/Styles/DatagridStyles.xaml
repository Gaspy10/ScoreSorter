<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#4d4d4d" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#688caf" />
        <Setter Property="BorderThickness" Value="0,1,2,3" />
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Style for DataGrid Row -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="#688caf" />
        <Setter Property="Foreground" Value="#688caf" />
        <Setter Property="BorderBrush" Value="#4d4d4d" />
        <Setter Property="BorderThickness" Value="0,0,2,0" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <!-- Style for DataGrid Cell -->
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="#688caf" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Style for Selected DataGrid Row -->
    <Style TargetType="DataGridRow" x:Key="SelectedRowStyle">
        <Setter Property="Background" Value="#4d4d4d" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</ResourceDictionary>
    