<Application x:Class="MVVM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MVVM"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Styles/LabelStyles.xaml"/>
                <ResourceDictionary Source="Styles/TextboxStyles.xaml"/>
                <ResourceDictionary Source="Styles/DatagridStyles.xaml"/>
                <ResourceDictionary Source="Styles/WindowStyle.xaml"/>
                <ResourceDictionary Source="Styles/ScrollViewerStyles.xaml"/>
                <ResourceDictionary Source="Styles/MenuItemStyles.xaml"/>
                <ResourceDictionary Source="Styles/IconStyles.xaml"/>

                <ResourceDictionary Source="Resources/Cross.xaml"/>
                <ResourceDictionary Source="Resources/Tick.xaml"/>
                <ResourceDictionary Source="Resources/Error.xaml"/>
                <ResourceDictionary Source="Resources/Open.xaml"/>
                <ResourceDictionary Source="Resources/Save.xaml"/>
                <ResourceDictionary Source="Resources/File.xaml"/>
                <ResourceDictionary Source="Resources/Succes.xaml"/>
                <ResourceDictionary Source="Resources/Image.xaml"/>
                <ResourceDictionary Source="Resources/Import.xaml"/>
                <ResourceDictionary Source="Resources/Export.xaml"/>
                <ResourceDictionary Source="Resources/Edit.xaml"/>
                <ResourceDictionary Source="Resources/Clear.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
