<UserControl x:Class="MVVM.CustomUserControls.WindowInteract"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVM.CustomUserControls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="100">

    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Button x:Name="minimizeButton" Content="-" Style="{StaticResource rightCorner}" 
                    Command="{Binding MinimizeCommand, UpdateSourceTrigger=PropertyChanged}"/>

            <Button x:Name="resizeButton" Content="O" Style="{StaticResource rightCorner}" 
                    Command="{Binding ResizeCommand, UpdateSourceTrigger=PropertyChanged}"/>

            <Button x:Name="closeButton" Content="X" Style="{StaticResource rightCorner}"
                    Command="{Binding CloseCommand, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Grid>
</UserControl>
